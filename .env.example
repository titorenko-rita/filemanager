DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_CSRF_TRUSTED_ORIGINS=

# Локальный защищённый режим: отключает Sentry и внешние автоуведомления.
PRIVACY_MODE=True
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_FILE_SIZE_MB=100
MAX_IMAGE_PIXELS=40000000
ALLOWED_UPLOAD_EXTENSIONS=.docx,.pdf,.txt,.md,.csv,.jpg,.jpeg,.png
CLAMAV_ENABLED=True
CLAMAV_FAIL_CLOSED=True
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FILE_NOTIFICATION_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
AUTOMATIC_EMAIL_NOTIFICATIONS=False
AUTOMATIC_EMAIL_ATTACHMENTS=False

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=False
ALLOW_TELEGRAM_IN_PRIVACY_MODE=False
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
ML_SERVICE_URL=http://127.0.0.1:5000
MAX_ANALYSIS_CHARS=200000
MAX_SENTIMENT_CHUNKS=24

TRASH_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=14
BACKUP_ROOT=backups

# Включайте только вместе с HTTPS-конфигурацией.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_BEHIND_HTTPS_PROXY=False
DJANGO_SECURE_HSTS_SECONDS=0

# Docker Compose defaults; change the password outside local development.
USE_POSTGRES=False
POSTGRES_DB=filemanager
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=filemanager
